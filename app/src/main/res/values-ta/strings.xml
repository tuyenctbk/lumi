    <string name="onboarding_title_welcome">லுமிக்கு உங்களை வரவேற்கிறோம்! ✨</string>
    <string name="onboarding_desc_welcome">உங்கள் குழந்தையின் பன்மொழி விளையாட்டுத் தோழன். நாங்கள் மொழிகள், வார்த்தைகளைக் கற்றுக்கொண்டு விளையாடுகிறோம்!</string>
    <string name="onboarding_title_games">ஒன்றாக விளையாடி கற்போம் 🎨</string>
    <string name="onboarding_desc_games">புதிர்களைத் தீர்க்கவும், வண்ணங்களை இணைக்கவும், நிழல்களைப் பொருத்தவும் மற்றும் மறைக்கப்பட்ட பொருட்களைக் கண்டறியவும்.</string>
    <string name="onboarding_title_permissions">அனுமதி கோரிக்கை 🎤</string>
    <string name="onboarding_desc_permissions">கற்றலை எளிமையாக்க, லுமிக்கு மைக்ரோஃபோன் மற்றும் அறிவிப்புகள் அனுமதி தேவைப்படுகிறது.</string>
    <string name="permission_mic">மைக்ரோஃபோன் அனுமதி</string>
